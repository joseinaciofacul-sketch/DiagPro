# Exemplo de DESENVOLVIMENTO. Não copiar os valores locais para produção.
# Segredos reais somente no ambiente do servidor, nunca no Electron/Git.
# Add the exact ngrok hostname (without https:// or path) while testing locally.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DEBUG=true
# Servidor somente: nunca distribuir estes valores no desktop.
DJANGO_SECRET_KEY=
# Compatibilidade: SECRET_KEY também é aceito; DJANGO_SECRET_KEY tem prioridade.
# Gerar uma chave aleatória forte para produção. Não reutilizar a chave local.
DATABASE_URL=
# DATABASE_URL tem prioridade sobre DB_NAME/USER/PASSWORD/HOST/PORT.
# PostgreSQL remoto: usar URL fornecida pelo provedor (senha URL-encoded).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=5
# Remoto: usar o modo TLS exigido pelo provedor, preferir verify-full com CA.
# DB_SSLMODE sobrescreve sslmode da URL quando não vazio.
DB_SSLMODE=
DB_SSLROOTCERT=
# Produção: DEBUG=false, hosts reais, HTTPS e cookies seguros.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origens do Vite e do build Electron local. Em produção, informe somente as origens realmente utilizadas.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null,file://
# Throttling usa cache local somente em desenvolvimento. Em produção, DEBUG=false
# exige uma URL Redis compartilhada para que todos os workers usem a mesma cota.
DJANGO_THROTTLE_CACHE_URL=
# DEBUG=true permite LocMem automaticamente. Em produção, não configure o override
# interno usado pelo smoke loopback: Redis compartilhado deve continuar obrigatório.
# Quantidade exata de proxies confiáveis que sobrescrevem X-Forwarded-For.
# Acesso direto/local = 0. Não copiar um número sem validar a topologia real.
DJANGO_NUM_PROXIES=0
# Limites iniciais do beta; revisar com métricas reais, sem torná-los garantia anti-DDoS.
DJANGO_THROTTLE_AUTH_IP_RATE=30/min
DJANGO_THROTTLE_AUTH_ACCOUNT_RATE=10/min
DJANGO_THROTTLE_REFRESH_RATE=60/min
DJANGO_THROTTLE_READ_RATE=300/min
DJANGO_THROTTLE_WRITE_RATE=60/min
DJANGO_THROTTLE_DIAGNOSTIC_RATE=60/min
DJANGO_THROTTLE_REMEDIATION_RATE=60/min
DJANGO_THROTTLE_PASSWORD_RATE=5/hour
DJANGO_THROTTLE_CHECKOUT_RATE=10/min
DJANGO_THROTTLE_WEBHOOK_RATE=300/min
DJANGO_THROTTLE_HEALTH_RATE=120/min
DJANGO_THROTTLE_GOOGLE_OAUTH_START_RATE=20/min
DJANGO_THROTTLE_GOOGLE_OAUTH_CALLBACK_RATE=60/min
DJANGO_THROTTLE_GOOGLE_OAUTH_COMPLETE_RATE=120/min
# Produção: origens HTTPS exatas. Electron file usa null, uma origem opaca não
# exclusiva do DiagPro. Permitir explicitamente somente se necessário; sem cookies.
DJANGO_LOG_LEVEL=INFO
DJANGO_HEALTHCHECK_DATABASE=true
# Google OpenID Connect. Use somente credenciais de um cliente OAuth do tipo
# Aplicativo Web; valores reais ficam exclusivamente no ambiente do servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.invalid/api/auth/google/callback/
GOOGLE_OAUTH_FLOW_TTL_SECONDS=300
# Vazios usam backend/staticfiles e backend/media. Media precisa de disco persistente
# privado antes de aceitar uploads; WhiteNoise NÃO serve media.
DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=
# Pagamentos continuam pausados; não preencher credenciais nesta etapa.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_USE_SANDBOX=true
MERCADO_PAGO_TIMEOUT_SECONDS=10
MERCADO_PAGO_LICENSE_DURATION_DAYS=30
